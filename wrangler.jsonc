// Cloudflare Workers · optimizo.ai
// /                    → v6.html (portada)
// /superpoder-lumina/* → Worker web-lumina (despliega web-lumina ANTES que este)
{
  "name": "web-optimizo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/superpoder-lumina", "/superpoder-lumina/*"] },
  "services": [{ "binding": "LUMINA", "service": "web-lumina" }],
  "routes": [{ "pattern": "optimizo.ai", "custom_domain": true }]
}
