// Cloudflare Workers · optimizo.ai (el dominio se asigna en el panel: Settings → Domains & Routes)
// /  → v6.html (portada)
{
  "name": "web-optimizo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/superpoder-lumina", "/superpoder-lumina/*"] }
}
